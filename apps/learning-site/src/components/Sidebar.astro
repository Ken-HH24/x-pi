---
import type { Chapter } from "@/lib/chapters";
import { chapterHref, chapterNumber } from "@/lib/chapters";
import { roadmap, roadmapGroups } from "@/data/roadmap";

interface Props {
  chapters: Chapter[];
  currentOrder?: number;
}

const { chapters, currentOrder } = Astro.props;
const chapterByOrder = new Map(chapters.map((chapter) => [chapter.data.order, chapter]));
---

<aside class="sidebar" data-sidebar>
  <nav aria-label="章节导航">
    {roadmapGroups.map((group) => (
      <section class="chapter-group">
        <div class="group-heading"><span class:list={["group-dot", group.color]}></span>{group.title}</div>
        <ol class="chapter-list">
          {group.range.map((order) => {
            const item = roadmap[order];
            const chapter = chapterByOrder.get(order);
            const isActive = currentOrder === order;
            return (
              <li>
                {chapter ? (
                  <a class:list={["chapter-link", { active: isActive }]} href={chapterHref(chapter)} aria-current={isActive ? "page" : undefined}>
                    <span class="chapter-number">c{chapterNumber(order)}</span>
                    <span>{item.shortTitle}</span>
                  </a>
                ) : (
                  <span class="chapter-link upcoming" aria-disabled="true">
                    <span class="chapter-number">c{chapterNumber(order)}</span>
                    <span>{item.shortTitle}</span>
                  </span>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </nav>
</aside>
