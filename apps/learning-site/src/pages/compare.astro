---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { chapterHref, chapterNumber, sortedChapters } from "@/lib/chapters";
import { createFileDiffs } from "@/lib/diff";
import { groupForChapter, roadmap } from "@/data/roadmap";

const chapters = sortedChapters(await getCollection("chapters"));
const versions = await Promise.all(chapters.map(async (chapter) => {
  const diffs = await createFileDiffs(chapter.data.diffFrom, chapter.data.lab, chapter.data.diffFiles);
  return {
    chapter,
    group: groupForChapter(chapter.data.order),
    changed: diffs.reduce((total, file) => total + file.additions + file.deletions, 0),
    files: diffs.length,
  };
}));
---

<BaseLayout title="版本对比" description="逐章查看 Nano Pi 新增的机制、行为与关键代码。">
  <div class="utility-page">
    <header class="utility-hero">
      <span class="eyebrow">VERSION COMPARE</span>
      <h1>每一章，只增加一个机制</h1>
      <p>对比每个可运行快照解决的问题、引入的能力和真实代码变化。</p>
    </header>
    <div class="version-table">
      <div class="version-row version-head"><span>版本</span><span>核心能力</span><span>变化</span><span>快照</span></div>
      {versions.map(({ chapter, group, changed, files }) => (
        <a class="version-row" href={chapterHref(chapter)}>
          <span><b>c{chapterNumber(chapter.data.order)}</b><small class:list={["layer-text", group.color]}>{group.title}</small></span>
          <span><strong>{roadmap[chapter.data.order].shortTitle}</strong><small>{chapter.data.summary}</small></span>
          <span><b>{changed}</b><small>changed LOC · {files} files</small></span>
          <span><code>{chapter.data.lab ? `labs/${chapter.data.lab}` : "docs only"}</code></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
